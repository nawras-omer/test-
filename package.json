{
  "name": "kalori",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Kalori \u2014 a multilingual (EN / AR / CKB), RTL-ready calorie tracking app foundation with authentication.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "preview": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"vite preview\"",
    "start": "node server/index.js",
    "typecheck": "tsc -b",
    "test:data": "node tests/foods.mjs",
    "test:assistant": "node tests/assistant.mjs",
    "test:smoke": "vite build --ssr src/dev/SmokeHarness.tsx --outDir ../.smoke --emptyOutDir --logLevel warn && node tests/smoke.mjs",
    "test": "npm run typecheck && npm run test:data && npm run test:assistant && npm run test:smoke"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
